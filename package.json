{
  "name": "kriyon",
  "version": "0.12.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc && vite build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:node && pnpm rust:fmt && pnpm rust:clippy && pnpm rust:test",
    "dev": "vite",
    "dmg": "bash scripts/release-mac.sh --bundles dmg",
    "fix": "ultracite fix",
    "icons": "node scripts/make-app-icon.mjs && tauri icon app-icon.svg && node scripts/make-tray-icon.mjs",
    "lint": "ultracite check",
    "prepare": "node scripts/install-git-hooks.mjs",
    "preview": "vite preview",
    "release": "node scripts/release.mjs",
    "release:mac": "bash scripts/release-mac.sh",
    "rust:clippy": "cargo clippy --all-targets -- -D warnings",
    "rust:fmt": "cargo fmt --check",
    "rust:test": "cargo test -- --test-threads=1",
    "smoke": "bash scripts/smoke.sh",
    "tauri": "tauri",
    "test": "vitest run",
    "test:node": "node --test .claude/hooks/*.test.mjs .claude/skills/pr-review/scripts/*.test.mjs crates/kriyon-core/companion/*.test.mjs scripts/*.test.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@lezer/highlight": "^1.2.5",
    "@replit/codemirror-indentation-markers": "^6.5.3",
    "@shikijs/core": "^4.5.0",
    "@shikijs/engine-javascript": "^4.5.0",
    "@shikijs/langs": "^4.5.0",
    "@shikijs/themes": "^4.5.0",
    "@tanstack/react-virtual": "^3.14.13",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-deep-link": "~2.6.1",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-fs": "~2.6.0",
    "@tauri-apps/plugin-notification": "~2.5.1",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "@tauri-apps/plugin-shell": "~2.4.1",
    "@xterm/addon-fit": "0.12.0-beta.301",
    "@xterm/addon-unicode11": "0.10.0-beta.301",
    "@xterm/addon-web-links": "0.13.0-beta.301",
    "@xterm/addon-webgl": "0.20.0-beta.300",
    "@xterm/xterm": "6.1.0-beta.304",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "4.14.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "git-cliff": "2.14.2",
    "jsdom": "^30.1.2",
    "lefthook": "^2.2.0",
    "typescript": "~7.0.2",
    "ultracite": "7.12.4",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@11.3.0"
}
