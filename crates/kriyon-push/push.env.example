# Settings for the push sender. Copy to push.env (never committed) and fill
# in. Each *_FILE names a file mounted into the container; the files hold
# the secrets, so this file holds none.

KRIYON_PUSH_LISTEN=0.0.0.0:8080
# A number phones and hosts name the key by. Raise it when you make a new key.
KRIYON_PUSH_KEY_ID=1
# 64 hex digits, made with: kriyon-push new-key > push.secret
KRIYON_PUSH_SECRET_FILE=/secrets/push.secret

# iPhone alerts (leave these out for none). From your Apple developer account.
APNS_KEY_FILE=/secrets/AuthKey_XXXXXXXXXX.p8
APNS_KEY_ID=XXXXXXXXXX
APNS_TEAM_ID=YYYYYYYYYY
APNS_TOPIC=com.example.kriyon
# https://api.sandbox.push.apple.com for development builds of the app.
APNS_ENDPOINT=https://api.push.apple.com

# Android alerts (leave this out for none). A Firebase service account's JSON key.
FCM_SERVICE_ACCOUNT_FILE=/secrets/firebase-service-account.json
