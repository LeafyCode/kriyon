# Kriyon — macOS signing & notarization secrets.
# Copy to `.env` (gitignored) and fill in. Consumed by `pnpm release:mac`.
#
# This is a PUBLIC repo, so the signing identity is NOT hardcoded in tauri.conf.json
# (that would break `tauri build` for anyone without your cert). It's set here instead,
# so a plain checkout builds unsigned and only your release build signs.
#
# The certificate itself is never in the repo — it lives in your login keychain.
# These values (company name, Team ID) are not secret, but the .p8 key below IS.

# --- Code signing ---
# Exact name of your Developer ID Application cert, from `security find-identity -v -p codesigning`.
APPLE_SIGNING_IDENTITY=Developer ID Application: Your Company Name (TEAMID1234)

# --- App Store Connect API key (notarization) ---
# Create at https://appstoreconnect.apple.com → Users and Access → Integrations → App Store Connect API.
# Give the key the "Developer" role. Download the AuthKey_XXXXXXXXXX.p8 ONCE (Apple won't let you re-download).

# Issuer ID — the UUID shown at the top of the API Keys page.
APPLE_API_ISSUER=00000000-0000-0000-0000-000000000000

# Key ID — the 10-char ID of the key (the XXXX in AuthKey_XXXX.p8).
APPLE_API_KEY=XXXXXXXXXX

# Absolute path to the .p8 file. Keep it OUTSIDE the repo (e.g. ~/.appstoreconnect/private_keys/).
APPLE_API_KEY_PATH=/Users/you/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8
